	{.Latin, .LTR, "ạ́ ệ ờ q̣̇ x͠y"},
	{.Latin, .LTR, "1/2 3⁄4 12⁄345 ½ ¾ 2024-10-23 10:45 $3.50 €12,00 100%"},
	{.Latin, .LTR, "en space em space thin space hair space nbsp x narrow x"},
	{.Latin, .LTR, "f‌f f‍f soft­hyphen word⁠joiner zero​width"},
	{.Latin, .LTR, "-> => != === !== <= >= /* */ ++ -- :: ... <!-- --> |> <|"},
