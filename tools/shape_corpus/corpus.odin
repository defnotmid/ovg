CORPUS := [?]Case {
	// Latin: ligatures, kerning, accents (precomposed and decomposed),
	// stacked marks, fractions, spaces, joiners, code ligatures.
	{.Latin, .LTR, "The quick brown fox jumps over the lazy dog."},
	{.Latin, .LTR, "office affluent fluffy ffi ffl ff fi fl"},
	{.Latin, .LTR, "AVATAR Typography WAVE To Yo LT Ty Vo P. F, 'A' \"quoted\""},
