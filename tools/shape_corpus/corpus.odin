// Feature settings -feature-sets runs (HarfBuzz syntax; ranges in
// characters).
FEATURE_SETS := [?]string {
	"",
	"liga=0",
	"kern=0",
	"smcp",
	"c2sc,smcp",
	"onum,tnum",
	"salt",
	"salt=2",
	"aalt=3",
	"ss01,ss02,ss03",
	"dlig,hlig",
	"zero,case",
	"frac",
	"sups",
	"subs",
	"liga=0[2:6]",
	"smcp[3:8],onum[0:4]",
	"salt=2[1:5]",
	"calt=0",
	"cv01,cv02=2,cv03=3",
	"ss05,ss06,ss07,ss08,ss19,ss20",
	"rand",
	"pnum,lnum,ordn",
	"locl=0,ccmp=0",
	"mark=0",
	"mkmk=0,curs=0",
}
