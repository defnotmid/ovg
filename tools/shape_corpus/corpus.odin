	{.Latin, .LTR, "(parentheses) [brackets] {braces} «guillemets» “quotes” ‘single’ — – ‐ ‑ …"},
	{.Latin, .LTR, "x̂ g̃ ŋ́ ɛ̀ ɔ̂ ə́ ʃ̩ ṉ ḏ"},
	{.Latin, .LTR, "A⃝ 1⃣ #️⃣ a︀ ❤️"},
